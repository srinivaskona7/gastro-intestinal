---
import Base from '../../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base title="Quiz" description="Flashcard quiz across every GI topic with simple spaced repetition.">
  <div class="mx-auto max-w-2xl px-4 py-10" data-pagefind-ignore id="quiz-root" data-src={`${base}quiz-data.json`}>
    <h1 class="text-3xl font-semibold text-teal-deep dark:text-teal-300">Quiz</h1>
    <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Flashcards from every topic. Reveal the answer, then grade yourself. Cards you miss come back first. Progress stays in this browser.</p>

    <form id="quiz-setup" class="mt-6 grid gap-3 rounded-xl border border-teal-deep/15 bg-white p-4 dark:bg-slate-900 sm:grid-cols-2">
      <label class="text-sm">Part
        <select id="f-part" class="study-field mt-1 block w-full"><option value="">All parts</option><option value="anatomy-physiology">Anatomy &amp; physiology</option><option value="pathology">Pathology</option></select>
      </label>
      <label class="text-sm">Group
        <select id="f-group" class="study-field mt-1 block w-full"><option value="">All groups</option></select>
      </label>
      <label class="text-sm">Cards per session
        <select id="f-size" class="study-field mt-1 block w-full"><option>10</option><option selected>20</option><option>50</option><option value="0">All</option></select>
      </label>
      <label class="flex items-center gap-2 self-end pb-1.5 text-sm"><input id="f-unlearned" type="checkbox" class="h-4 w-4 accent-teal-700" /> Only topics not learned yet</label>
      <label class="flex items-center gap-2 text-sm"><input id="f-exam" type="checkbox" class="h-4 w-4 accent-teal-700" /> Timed exam mode <span class="text-xs text-slate-500">(60 sec)</span></label>
      <div class="sm:col-span-2 flex flex-wrap items-center gap-3">
        <button type="submit" class="quiz-btn quiz-btn-primary" id="start-btn" disabled>Start quiz</button>
        <span id="match-count" class="text-sm text-slate-500" aria-live="polite">Loading cards…</span>
      </div>
      <p id="boxes" class="sm:col-span-2 text-xs text-slate-500"></p>
    </form>

    <section id="quiz-card" class="mt-6 hidden" aria-live="polite" aria-label="Quiz card">
      <div class="flex items-center justify-between text-xs text-slate-500"><span id="q-pos"></span><span id="q-timer" class="font-semibold text-coral"></span><span id="q-meta"></span></div>
      <div class="mt-2 rounded-xl border border-teal-deep/20 bg-white p-5 dark:bg-slate-900">
        <p id="q-text" class="font-display text-xl leading-snug"></p>
          <div id="q-explanation" class="mt-4 hidden rounded-lg bg-sage p-3 dark:bg-teal-900/30"><p class="text-xs font-bold uppercase tracking-wider text-coral">Explanation</p><p id="q-answer" class="mt-1 text-[0.95rem] leading-relaxed"></p></div>
      </div>
      <div class="mt-4 flex flex-wrap gap-3">
        <button type="button" id="reveal-btn" class="quiz-btn quiz-btn-primary">Show answer <span class="text-xs opacity-80">(Space)</span></button>
        <button type="button" id="got-btn" class="quiz-btn quiz-btn-primary hidden">Got it <span class="text-xs opacity-80">(1)</span></button>
        <button type="button" id="again-btn" class="quiz-btn quiz-btn-coral hidden">Again <span class="text-xs opacity-80">(2)</span></button>
        <button type="button" id="stop-btn" class="quiz-btn ml-auto">End session</button>
      </div>
    </section>

    <section id="quiz-summary" class="mt-6 hidden rounded-xl border border-teal-deep/20 bg-white p-5 dark:bg-slate-900" aria-label="Session summary" tabindex="-1">
      <h2 class="text-xl font-semibold text-teal-deep dark:text-teal-300">Session summary</h2>
      <p id="sum-text" class="mt-2"></p>
      <div id="sum-missed" class="mt-3 hidden"><p class="text-sm font-semibold text-coral">To revisit</p><ul id="sum-list" class="mt-1 list-disc space-y-1 pl-5 text-sm"></ul></div>
      <div class="mt-4 flex flex-wrap gap-3">
        <button type="button" id="retry-btn" class="quiz-btn quiz-btn-coral hidden">Retry missed</button>
        <button type="button" id="again-session-btn" class="quiz-btn quiz-btn-primary">New session</button>
      </div>
    </section>
    <noscript><p class="mt-6 text-sm">The quiz needs JavaScript. Every topic page still has its self-test.</p></noscript>
  </div>
</Base>

<script>
  import { getLearned, getBoxes, grade } from '../../lib/study-store';
  type Card = { id: string; slug: string; title: string; part: string; group: string; q: string; a: string };
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const root = $('quiz-root');
  const fPart = $<HTMLSelectElement>('f-part'), fGroup = $<HTMLSelectElement>('f-group'), fSize = $<HTMLSelectElement>('f-size'), fExam = $<HTMLInputElement>('f-exam');
  const fUnl = $<HTMLInputElement>('f-unlearned'), startBtn = $<HTMLButtonElement>('start-btn'), count = $('match-count');
  let deck: Card[] = [], queue: Card[] = [], idx = 0, got = 0, missed: Card[] = [], revealed = false, active = false, timer = 0, clock = 0;

  const show = (id: string, on: boolean) => $(id).classList.toggle('hidden', !on);
  const matching = () => {
    const learned = getLearned();
    return deck.filter((c) => (!fPart.value || c.part === fPart.value) && (!fGroup.value || c.group === fGroup.value) && (!fUnl.checked || !learned.has(c.slug)));
  };
  function refreshGroups() {
    const cur = fGroup.value;
    const groups = [...new Set(deck.filter((c) => !fPart.value || c.part === fPart.value).map((c) => c.group))];
    fGroup.replaceChildren(new Option('All groups', ''), ...groups.map((g) => new Option(g, g)));
    fGroup.value = groups.includes(cur) ? cur : '';
  }
  function refreshCount() {
    const n = matching().length;
    count.textContent = `${n} card${n === 1 ? '' : 's'} match`;
    startBtn.disabled = n === 0;
    const b = getBoxes(); const tally = [0, 0, 0];
    deck.forEach((c) => tally[(b[c.id] ?? 1) - 1]++);
    $('boxes').textContent = `Leitner boxes: box 1 ${tally[0]} · box 2 ${tally[1]} · box 3 ${tally[2]}`;
  }
  function begin(cards: Card[]) {
    const b = getBoxes();
    // Shuffle, then stable-sort by box so the weakest cards come first.
    const shuffled = cards.map((c) => [Math.random(), c] as const).sort((x, y) => x[0] - y[0]).map((x) => x[1]);
    shuffled.sort((x, y) => (b[x.id] ?? 1) - (b[y.id] ?? 1));
    const size = Number(fSize.value);
    queue = size ? shuffled.slice(0, size) : shuffled;
    idx = 0; got = 0; missed = []; active = true;
    clearInterval(clock); timer = fExam.checked ? 60 : 0; $('q-timer').textContent = timer ? `⏱ ${timer}s` : ''; if(timer) clock=window.setInterval(()=>{ timer--; $('q-timer').textContent=`⏱ ${timer}s`; if(timer<=0){clearInterval(clock); finish();}},1000);
    show('quiz-setup', false); show('quiz-summary', false); show('quiz-card', true);
    render();
  }
  function render() {
    const c = queue[idx];
    revealed = false;
    $('q-pos').textContent = `Card ${idx + 1} of ${queue.length}`;
    $('q-meta').textContent = `${c.title} · box ${getBoxes()[c.id] ?? 1}`;
    $('q-text').textContent = c.q;
    $('q-answer').textContent = c.a;
    show('q-explanation', false); show('got-btn', false); show('again-btn', false); show('reveal-btn', true);
    $('reveal-btn').focus();
  }
  function reveal() {
    if (!active || revealed) return;
    revealed = true;
    show('q-explanation', true); show('reveal-btn', false); show('got-btn', true); show('again-btn', true);
    $('got-btn').focus();
  }
  function answer(gotIt: boolean) {
    if (!active || !revealed) return;
    const c = queue[idx];
    grade(c.id, gotIt);
    gotIt ? got++ : missed.push(c);
    if (++idx >= queue.length) finish(); else render();
  }
  function finish() {
    active = false;
    clearInterval(clock);
    show('quiz-card', false); show('quiz-summary', true);
    const total = queue.length;
    $('sum-text').textContent = `You got ${got} of ${total} (${total ? Math.round((got / total) * 100) : 0}%). Missed cards drop to box 1 and come back first next time.`;
    $('sum-list').replaceChildren(...missed.map((c) => Object.assign(document.createElement('li'), { textContent: c.q })));
    show('sum-missed', missed.length > 0); show('retry-btn', missed.length > 0);
    $('quiz-summary').focus();
  }
  function toSetup() { active = false; show('quiz-card', false); show('quiz-summary', false); show('quiz-setup', true); refreshCount(); startBtn.focus(); }

  $('quiz-setup').addEventListener('submit', (e) => { e.preventDefault(); begin(matching()); });
  fPart.addEventListener('change', () => { refreshGroups(); refreshCount(); });
  fGroup.addEventListener('change', refreshCount);
  fUnl.addEventListener('change', refreshCount);
  $('reveal-btn').addEventListener('click', reveal);
  $('got-btn').addEventListener('click', () => answer(true));
  $('again-btn').addEventListener('click', () => answer(false));
  $('stop-btn').addEventListener('click', () => (idx > 0 ? (queue = queue.slice(0, idx), finish()) : toSetup()));
  $('retry-btn').addEventListener('click', () => begin(missed));
  $('again-session-btn').addEventListener('click', toSetup);
  addEventListener('keydown', (e) => {
    if (!active || e.ctrlKey || e.metaKey || e.altKey) return;
    if (e.key === ' ' && !revealed) { e.preventDefault(); reveal(); }
    else if (e.key === '1' && revealed) answer(true);
    else if (e.key === '2' && revealed) answer(false);
  });

  fetch(root.dataset.src!).then((r) => r.json()).then((d: { cards: Card[] }) => {
    deck = d.cards; refreshGroups(); refreshCount();
  }).catch(() => { count.textContent = 'Could not load the cards. Reload to try again.'; });
</script>
