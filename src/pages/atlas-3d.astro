---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import cfg from '../data/atlas-organs.json';
const base = import.meta.env.BASE_URL;
const titles = new Map((await getCollection('topics')).map((t) => [t.id, t.data.title]));
const organs = cfg.organs.map((o) => ({
  ...o,
  links: o.topics.map((s) => {
    const title = titles.get(s);
    if (!title) throw new Error(`atlas-3d: organ "${o.id}" maps to unknown topic "${s}"`);
    return { href: `${base}topics/${s}/`, title };
  }),
}));
---
<Base title="3D atlas" description="Rotatable 3D model of the gastrointestinal organs. Toggle organs, explode the view and jump to the matching topics.">
  <div class="mx-auto max-w-6xl px-4 pb-10 pt-10">
    <h1 class="text-3xl font-semibold text-teal-deep dark:text-teal-300">3D atlas of the GI tract</h1>
    <p class="mt-2 max-w-3xl text-slate-600 dark:text-slate-300">Drag to rotate, pinch or scroll to zoom. Tap an organ, or pick it from the list, to see its name and the topics that cover it. The model is an adult male reference; real anatomy varies.</p>

    <div id="atlas3d" data-model={`${base}models/${cfg.model}`} class="mt-6 grid gap-4 lg:grid-cols-[1fr_20rem]">
      <div>
        <div id="atlas3d-stage" class="relative h-[62vh] min-h-[22rem] overflow-hidden rounded-xl border border-teal-deep/20 bg-gradient-to-b from-white to-sage dark:from-[#16211f] dark:to-[#0f1716]">
          <canvas id="atlas3d-canvas" class="block h-full w-full touch-none" tabindex="0" role="img" aria-label="Interactive 3D model of the gastrointestinal organs. Use the organ list for keyboard access."></canvas>
          <p id="atlas3d-status" class="absolute inset-0 flex items-center justify-center p-6 text-center text-sm text-slate-600 dark:text-slate-300" role="status">Loading 3D model…</p>
        </div>
        <div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
          <label class="flex items-center gap-2">Explode
            <input id="atlas3d-explode" type="range" min="0" max="100" value="0" class="w-40 accent-teal-700" aria-label="Explode organs apart" />
          </label>
          <button id="atlas3d-reset" type="button" class="rounded-md border border-teal-deep/30 px-3 py-1 hover:border-teal-deep">Reset view</button>
          <button id="atlas3d-all" type="button" class="rounded-md border border-teal-deep/30 px-3 py-1 hover:border-teal-deep">Show all</button>
        </div>
      </div>

      <aside class="space-y-4">
        <section aria-labelledby="organ-list-h">
          <h2 id="organ-list-h" class="mb-2 text-lg font-semibold text-teal-deep dark:text-teal-300">Organs</h2>
          <ul class="space-y-1">
            {organs.map((o) => (
              <li class="flex items-center gap-2" data-organ={o.id}>
                <input type="checkbox" checked id={`vis-${o.id}`} class="h-4 w-4 accent-teal-700" aria-label={`Show ${o.label}`} />
                <span class="h-3 w-3 shrink-0 rounded-full border border-black/20" style={`background:${o.color}`} aria-hidden="true"></span>
                <button type="button" class="organ-btn flex-1 rounded px-2 py-1 text-left hover:bg-sage aria-pressed:bg-teal-deep aria-pressed:text-white dark:hover:bg-teal-900/30" aria-pressed="false">{o.label}</button>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="organ-info-h" class="rounded-xl border border-teal-deep/20 bg-white p-4 dark:bg-slate-900">
          <h2 id="organ-info-h" class="text-lg font-semibold text-teal-deep dark:text-teal-300">Selected organ</h2>
          <div id="atlas3d-info" aria-live="polite" class="mt-1 text-sm text-slate-600 dark:text-slate-300"><p>Nothing selected.</p></div>
        </section>
      </aside>
    </div>

    <template id="organ-topics">
      {organs.map((o) => (
        <div data-for={o.id} data-label={o.label}>
          {o.note && <p class="mb-1 italic">{o.note}</p>}
          {o.links.length > 0 && (
            <ul class="list-disc space-y-1 pl-5">
              {o.links.map((l) => <li><a class="text-teal-deep underline dark:text-teal-300" href={l.href}>{l.title}</a></li>)}
            </ul>
          )}
        </div>
      ))}
    </template>

    <section id="atlas3d-fallback" class="mt-8 hidden" aria-labelledby="fb-h">
      <h2 id="fb-h" class="text-lg font-semibold text-teal-deep dark:text-teal-300">Organs and their topics</h2>
      {organs.filter((o) => o.links.length).map((o) => (
        <div class="mt-3"><h3 class="font-semibold">{o.label}</h3>
          <ul class="list-disc pl-5 text-sm">{o.links.map((l) => <li><a class="text-teal-deep underline dark:text-teal-300" href={l.href}>{l.title}</a></li>)}</ul></div>
      ))}
    </section>

    <section class="mt-10 rounded-xl border border-teal-deep/15 bg-sage p-4 text-sm text-slate-700 dark:bg-teal-900/20 dark:text-slate-300" aria-labelledby="attr-h">
      <h2 id="attr-h" class="font-semibold">Attribution</h2>
      <p class="mt-1">Anatomy data: <a class="underline" href="https://dbarchive.biosciencedbc.jp/en/bodyparts3d/download.html">BodyParts3D</a>, &copy; The Database Center for Life Science, licensed under
        <a class="underline" href="https://creativecommons.org/licenses/by/4.0/">CC Attribution 4.0 International</a> (licence terms at <a class="underline" href="https://dbarchive.biosciencedbc.jp/en/bodyparts3d/lic.html">dbarchive.biosciencedbc.jp</a>, checked 2026-10-03).
        Mitsuhashi et al. (2009), <a class="underline" href="https://doi.org/10.1093/nar/gkn613">doi:10.1093/nar/gkn613</a>.</p>
      <p class="mt-1">Changes: selected digestive organs extracted (the liver is assembled from its hepatic segments), units in metres with Y up, simplified geometry taken from the <a class="underline" href="https://github.com/ashemag/human-atlas">Human Atlas</a> pack, merged per organ and recoloured. Rendered with three.js (MIT). Full credits are in CREDITS.md in the repository.</p>
    </section>
  </div>
</Base>

<script>
  const root = document.getElementById('atlas3d')!;
  const stage = document.getElementById('atlas3d-stage')!;
  const canvas = document.getElementById('atlas3d-canvas') as HTMLCanvasElement;
  const status = document.getElementById('atlas3d-status')!;
  const info = document.getElementById('atlas3d-info')!;
  const tpl = document.getElementById('organ-topics') as HTMLTemplateElement;
  const rows = [...root.querySelectorAll<HTMLElement>('li[data-organ]')];
  const colorOf = (id: string) => rows.find((r) => r.dataset.organ === id)?.querySelector<HTMLElement>('span')?.style.background || '#c9a79a';

  function fail(msg: string) {
    status.textContent = msg;
    status.classList.remove('hidden');
    document.getElementById('atlas3d-fallback')!.classList.remove('hidden');
  }

  function showInfo(id: string | null) {
    rows.forEach((r) => r.querySelector('.organ-btn')!.setAttribute('aria-pressed', String(r.dataset.organ === id)));
    const src = id && tpl.content.querySelector<HTMLElement>(`[data-for="${id}"]`);
    if (!src) { info.innerHTML = '<p>Nothing selected.</p>'; return; }
    const h = document.createElement('p');
    h.className = 'mb-2 text-base font-semibold text-slate-900 dark:text-slate-100';
    h.textContent = src.dataset.label!;
    info.replaceChildren(h, ...[...src.children].map((c) => c.cloneNode(true)));
    if (!src.querySelector('ul')) info.append(Object.assign(document.createElement('p'), { textContent: 'No topic page is linked to this organ.' }));
  }

  async function start() {
    const THREE = await import('three');
    const [{ GLTFLoader }, { OrbitControls }] = await Promise.all([
      import('three/examples/jsm/loaders/GLTFLoader.js'),
      import('three/examples/jsm/controls/OrbitControls.js'),
    ]);

    let renderer: InstanceType<typeof THREE.WebGLRenderer>;
    try {
      renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
    } catch {
      return fail('Your browser could not start WebGL, so the 3D model is unavailable. The topics for each organ are listed below.');
    }
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.01, 10);
    scene.add(new THREE.HemisphereLight(0xffffff, 0x556070, 1.6));
    const key = new THREE.DirectionalLight(0xffffff, 2.2);
    key.position.set(0.5, 1, 1);
    scene.add(key);
    scene.add(new THREE.DirectionalLight(0xffffff, 0.8).translateX(-1).translateY(0.3).translateZ(-0.5));

    const gltf = await new GLTFLoader().loadAsync(root.dataset.model!).catch(() => null);
    if (!gltf) return fail('The 3D model failed to load. The topics for each organ are listed below.');

    const meshes = new Map<string, InstanceType<typeof THREE.Mesh>>();
    gltf.scene.traverse((o) => {
      const m = o as InstanceType<typeof THREE.Mesh>;
      if (!m.isMesh) return;
      m.geometry.computeVertexNormals();
      m.material = new THREE.MeshStandardMaterial({ color: colorOf(m.name), roughness: 0.55, metalness: 0.05, side: THREE.DoubleSide });
      meshes.set(m.name, m);
    });
    scene.add(gltf.scene);

    // Explode: push each organ away from the centre of the whole set.
    const all = new THREE.Box3().setFromObject(gltf.scene);
    const centre = all.getCenter(new THREE.Vector3());
    const size = all.getSize(new THREE.Vector3());
    const dirs = new Map<string, InstanceType<typeof THREE.Vector3>>();
    meshes.forEach((m, id) => {
      m.geometry.computeBoundingBox();
      dirs.set(id, m.geometry.boundingBox!.getCenter(new THREE.Vector3()).sub(centre).normalize());
    });
    const explode = (f: number) => meshes.forEach((m, id) => m.position.copy(dirs.get(id)!).multiplyScalar(f * size.y * 0.2));

    const home = () => {
      camera.position.set(centre.x, centre.y, centre.z + size.y * 1.65);
      controls.target.copy(centre);
      controls.update();
    };
    const controls = new OrbitControls(camera, canvas);
    controls.enableDamping = true;
    controls.minDistance = size.y * 0.6;
    controls.maxDistance = size.y * 6;
    controls.listenToKeyEvents(canvas);
    home();

    function resize() {
      const w = stage.clientWidth, h = stage.clientHeight;
      renderer.setSize(w, h, false);
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
    }
    new ResizeObserver(resize).observe(stage);
    resize();

    const select = (id: string | null) => {
      meshes.forEach((m, k) => (m.material as InstanceType<typeof THREE.MeshStandardMaterial>).emissive.set(k === id ? 0x555555 : 0x000000));
      showInfo(id);
    };

    // Tap (not drag) picks an organ.
    const ray = new THREE.Raycaster();
    let down: [number, number] | null = null;
    canvas.addEventListener('pointerdown', (e) => { down = [e.clientX, e.clientY]; });
    canvas.addEventListener('pointerup', (e) => {
      if (!down || Math.hypot(e.clientX - down[0], e.clientY - down[1]) > 5) return;
      const r = canvas.getBoundingClientRect();
      ray.setFromCamera(new THREE.Vector2(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1), camera);
      const hit = ray.intersectObjects([...meshes.values()].filter((m) => m.visible))[0];
      select(hit ? hit.object.name : null);
    });

    rows.forEach((row) => {
      const id = row.dataset.organ!;
      row.querySelector<HTMLInputElement>('input')!.addEventListener('change', (e) => {
        const on = (e.target as HTMLInputElement).checked;
        const m = meshes.get(id);
        if (m) m.visible = on;
      });
      row.querySelector('.organ-btn')!.addEventListener('click', () => select(row.querySelector('.organ-btn')!.getAttribute('aria-pressed') === 'true' ? null : id));
    });
    document.getElementById('atlas3d-explode')!.addEventListener('input', (e) => explode(Number((e.target as HTMLInputElement).value) / 100));
    document.getElementById('atlas3d-reset')!.addEventListener('click', home);
    document.getElementById('atlas3d-all')!.addEventListener('click', () => {
      rows.forEach((r) => { r.querySelector<HTMLInputElement>('input')!.checked = true; });
      meshes.forEach((m) => (m.visible = true));
    });

    status.classList.add('hidden');
    renderer.setAnimationLoop(() => { controls.update(); renderer.render(scene, camera); });
    canvas.dataset.ready = '1';
  }

  start().catch((e) => { console.error(e); fail('The 3D viewer could not start. The topics for each organ are listed below.'); });
</script>
