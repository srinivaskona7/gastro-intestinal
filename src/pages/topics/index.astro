---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LearnedProgress from '../../components/LearnedProgress.astro';
const base = import.meta.env.BASE_URL;
const all = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const parts = [
  { id: 'anatomy-physiology', label: 'Anatomy & physiology' },
  { id: 'pathology', label: 'Pathology' },
];
---
<Base title="All topics">
  <div class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-3xl font-semibold text-teal-deep dark:text-teal-300">All topics</h1>
    <LearnedProgress slugs={all.map((t) => t.id)} class="mt-3 max-w-sm" />
    <section class="mt-6 rounded-2xl border border-teal-deep/15 bg-white p-4 shadow-sm dark:bg-slate-900" aria-label="Filter topics">
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
        <label class="text-sm">Search<input id="topic-search" list="topic-suggestions" class="study-field mt-1 block w-full" placeholder="Try liver, jaundice…" /><datalist id="topic-suggestions">{all.flatMap(t => [t.data.title, t.data.organ, ...(t.data.tags ?? [])]).filter((v, i, a) => v && a.indexOf(v) === i).slice(0, 120).map(v => <option value={v} />)}</datalist></label>
        <label class="text-sm">Organ<select id="topic-organ" class="study-field mt-1 block w-full"><option value="">All organs</option>{[...new Set(all.map(t => t.data.organ))].sort().map(o => <option>{o}</option>)}</select></label>
        <label class="text-sm">Difficulty<select id="topic-difficulty" class="study-field mt-1 block w-full"><option value="">Any level</option><option value="foundational">Foundational</option><option value="intermediate">Intermediate</option><option value="advanced">Advanced</option></select></label>
        <label class="text-sm">Exam relevance<select id="topic-exam" class="study-field mt-1 block w-full"><option value="">Any relevance</option><option value="high">High-yield</option><option value="medium">Useful</option><option value="low">Further reading</option></select></label>
        <label class="text-sm">Study status<select id="topic-status" class="study-field mt-1 block w-full"><option value="">All topics</option><option value="unlearned">To learn</option><option value="learned">Learned</option><option value="bookmarked">Bookmarked</option></select></label>
      </div>
      <p id="topic-count" class="mt-3 text-xs text-slate-500" aria-live="polite"></p>
    </section>
    {parts.map((p) => {
      const items = all.filter((t) => t.data.part === p.id);
      const groups = [...new Set(items.map((t) => t.data.group))];
      return (
        <section id={p.id} class="mt-10 scroll-mt-20">
          <h2 class="text-2xl font-semibold">{p.label}</h2>
          {groups.map((g) => (
            <div class="mt-5">
              <h3 class="text-sm font-bold uppercase tracking-wider text-coral">{g}</h3>
              <ul class="mt-2 grid gap-x-8 gap-y-1 sm:grid-cols-2">
                {items.filter((t) => t.data.group === g).map((t) => (
                  <li data-topic-card data-title={`${t.data.title} ${t.data.summary} ${t.data.tags.join(' ')}`} data-organ={t.data.organ} data-difficulty={t.data.difficulty} data-exam={t.data.examRelevance} data-slug={t.id}><a href={`${base}topics/${t.id}/`} data-topic-slug={t.id} class="text-teal-deep hover:underline dark:text-teal-300">{t.data.title}</a><span class="ml-2 text-[10px] uppercase text-slate-400">{t.data.examRelevance} exam</span></li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      );
    })}
  </div>
</Base>
<script>
  import { getLearned, getBookmarks } from '../../lib/study-store';
  const cards = [...document.querySelectorAll<HTMLElement>('[data-topic-card]')];
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const params = new URLSearchParams(location.search); if (params.get('organ')) $('topic-organ').value = params.get('organ')!;
  function filter() { const q=$('topic-search').value.toLowerCase(), o=$('topic-organ').value, d=$('topic-difficulty').value, e=$('topic-exam').value, s=$('topic-status').value, l=getLearned(), b=getBookmarks(); let n=0;
    cards.forEach(c => { const ok=(!q||c.dataset.title!.toLowerCase().includes(q))&&(!o||c.dataset.organ===o)&&(!d||c.dataset.difficulty===d)&&(!e||c.dataset.exam===e)&&(!s||(s==='learned'?l.has(c.dataset.slug!):s==='unlearned'?!l.has(c.dataset.slug!):b.has(c.dataset.slug!))); c.hidden=!ok; if(ok)n++; }); document.getElementById('topic-count')!.textContent=`Showing ${n} of ${cards.length} topics`; }
  ['topic-search','topic-organ','topic-difficulty','topic-exam','topic-status'].forEach(id=>document.getElementById(id)!.addEventListener('input',filter)); filter(); addEventListener('storage',filter); addEventListener('gi-atlas:change',filter);
</script>
