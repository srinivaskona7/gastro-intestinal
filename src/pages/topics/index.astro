---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import LearnedProgress from '../../components/LearnedProgress.astro';
const base = import.meta.env.BASE_URL;
const all = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const parts = [
  { id: 'anatomy-physiology', label: 'Anatomy & physiology' },
  { id: 'pathology', label: 'Pathology' },
];
---
<Base title="All topics">
  <div class="mx-auto max-w-5xl px-4 py-10">
    <h1 class="text-3xl font-semibold text-teal-deep dark:text-teal-300">All topics</h1>
    <LearnedProgress slugs={all.map((t) => t.id)} class="mt-3 max-w-sm" />
    {parts.map((p) => {
      const items = all.filter((t) => t.data.part === p.id);
      const groups = [...new Set(items.map((t) => t.data.group))];
      return (
        <section id={p.id} class="mt-10 scroll-mt-20">
          <h2 class="text-2xl font-semibold">{p.label}</h2>
          {groups.map((g) => (
            <div class="mt-5">
              <h3 class="text-sm font-bold uppercase tracking-wider text-coral">{g}</h3>
              <ul class="mt-2 grid gap-x-8 gap-y-1 sm:grid-cols-2">
                {items.filter((t) => t.data.group === g).map((t) => (
                  <li><a href={`${base}topics/${t.id}/`} data-topic-slug={t.id} class="text-teal-deep hover:underline dark:text-teal-300">{t.data.title}</a></li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      );
    })}
  </div>
</Base>
