---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: all[i - 1], next: all[i + 1] },
  }));
}
const { entry, prev, next } = Astro.props;
const base = import.meta.env.BASE_URL;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth <= 3);
const minutes = Math.max(1, Math.round((entry.body ?? '').split(/\s+/).length / 200));
const partLabel = entry.data.part === 'pathology' ? 'Pathology' : 'Anatomy & physiology';
---
<Base title={entry.data.title} description={entry.data.summary}>
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-8 lg:grid-cols-[minmax(0,1fr)_14rem]">
    <article data-pagefind-body>
      <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
        <a href={`${base}topics/#${entry.data.part}`} class="hover:text-coral">{partLabel}</a> <span aria-hidden="true">/</span> {entry.data.group}
      </nav>
      <h1 class="mt-2 text-4xl font-semibold leading-tight text-teal-deep dark:text-teal-300" data-pagefind-meta="title">{entry.data.title}</h1>
      <p class="mt-2 text-lg text-slate-600 dark:text-slate-300">{entry.data.summary}</p>
      <p class="mt-1 text-xs text-slate-500">{minutes} min read</p>
      <div class="no-print mt-3" data-pagefind-ignore>
        <button type="button" id="learned-btn" data-slug={entry.id} aria-pressed="false" class="learned-btn rounded-lg border border-teal-deep px-4 py-2 text-sm font-medium text-teal-deep hover:bg-sage dark:border-teal-300 dark:text-teal-300 dark:hover:bg-teal-900/30">Mark as learned</button>
        <button type="button" id="bookmark-btn" aria-pressed="false" class="ml-2 rounded-lg border border-teal-deep px-4 py-2 text-sm font-medium text-teal-deep hover:bg-sage dark:border-teal-300 dark:text-teal-300">☆ Bookmark</button>
      </div>

      <aside class="my-6 rounded-xl border border-coral/40 bg-coral/10 p-4" aria-label="High-yield summary">
        <p class="text-xs font-bold uppercase tracking-wider text-coral">High-yield in 30 seconds</p>
        <ul class="mt-2 list-disc space-y-1 pl-5 text-[0.95rem]">
          {entry.data.highYield.map((p) => <li>{p}</li>)}
        </ul>
      </aside>

      <div class="prose prose-slate max-w-none dark:prose-invert prose-headings:font-display">
        <Content />
      </div>

      <section class="no-print mt-10 rounded-xl border border-teal-deep/15 bg-sage p-5 dark:bg-teal-900/20" aria-labelledby="personal-study">
        <h2 id="personal-study" class="mt-0 border-0 pb-0 text-xl text-teal-deep dark:text-teal-300">Personal study note</h2>
        <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Capture a mnemonic, question, or exam trap. It stays in this browser.</p>
        <textarea id="topic-note" class="study-field mt-3 min-h-24 w-full" placeholder="My key takeaway…" aria-label="Personal study note"></textarea>
        <button type="button" id="save-note" class="quiz-btn quiz-btn-primary mt-2">Save note</button><span id="note-status" class="ml-2 text-xs text-slate-500" aria-live="polite"></span>
      </section>

      <nav class="mt-14 grid gap-3 border-t border-teal-deep/15 pt-6 sm:grid-cols-2" aria-label="Previous and next topic">
        {prev ? <a href={`${base}topics/${prev.id}/`} class="rounded-lg border border-teal-deep/20 p-3 hover:border-teal-deep"><span class="block text-xs text-slate-500">← Previous</span>{prev.data.title}</a> : <span />}
        {next ? <a href={`${base}topics/${next.id}/`} class="rounded-lg border border-teal-deep/20 p-3 text-right hover:border-teal-deep"><span class="block text-xs text-slate-500">Next →</span>{next.data.title}</a> : <span />}
      </nav>
    </article>

    <aside class="no-print hidden lg:block">
      <nav class="sticky top-20 text-sm" aria-label="On this page">
        <p class="mb-2 text-xs font-bold uppercase tracking-wider text-slate-500">On this page</p>
        <ul class="space-y-1.5 border-l border-teal-deep/20 pl-3">
          {toc.map((h) => <li class={h.depth === 3 ? 'pl-3 text-xs' : 'font-medium'}><a href={`#${h.slug}`} class="text-slate-600 hover:text-coral dark:text-slate-300">{h.text}</a></li>)}
        </ul>
      </nav>
    </aside>
  </div>
</Base>
<script define:vars={{ slug: entry.id }}>
  import { getLearned, setLearned, getBookmarks, toggleBookmark, getNotes, setNote, touch } from '../../lib/study-store';
  touch(slug);
  const btn = document.getElementById('learned-btn') as HTMLButtonElement;
  const paint = () => {
    const on = getLearned().has(btn.dataset.slug!);
    btn.setAttribute('aria-pressed', String(on));
    btn.textContent = on ? '✓ Learned (click to undo)' : 'Mark as learned';
  };
  btn.addEventListener('click', () => {
    setLearned(btn.dataset.slug!, btn.getAttribute('aria-pressed') !== 'true');
    paint(); dispatchEvent(new Event('gi-atlas:change'));
  });
  paint();
  const bm = document.getElementById('bookmark-btn') as HTMLButtonElement;
  const paintBookmark = () => { const on=getBookmarks().has(slug); bm.setAttribute('aria-pressed',String(on)); bm.textContent=on?'★ Bookmarked':'☆ Bookmark'; };
  bm.addEventListener('click',()=>{toggleBookmark('{entry.id}');paintBookmark();}); paintBookmark();
  const note=document.getElementById('topic-note') as HTMLTextAreaElement, status=document.getElementById('note-status')!; note.value=getNotes()[slug] ?? '';
  document.getElementById('save-note')!.addEventListener('click',()=>{setNote(slug,note.value);status.textContent='Saved'; setTimeout(()=>status.textContent='',1600);});
  addEventListener('storage', paint);
</script>
